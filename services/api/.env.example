# Cloud Functions environment variables
# Copy this file to .env and fill in the values for local emulator use.
# Production secrets (STRIPE_SECRET_KEY, STRIPE_WEBHOOK_SECRET, ALGOLIA_API_KEY)
# must be stored in GCP Secret Manager via: firebase functions:secrets:set <NAME>
# All other variables below are set as regular Firebase environment variables
# in the Firebase Console → Functions → Configuration → Environment variables.

# ── Stripe (secrets → GCP Secret Manager) ────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs — find in Stripe Dashboard → Product catalog
# Pro tier: $149/mo CAD recurring
STRIPE_PRICE_CORE=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_PRO=price_...

# ── Algolia (API key → GCP Secret Manager) ────────────────────────────────────
# App ID is public; API key is the Admin/Write key from Algolia Dashboard → API Keys
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=
ALGOLIA_INDEX_NAME=master_products
ALGOLIA_MERCHANT_INDEX_NAME=merchant_products

# ── App config ────────────────────────────────────────────────────────────────
APP_URL=https://spendigo.ca
ADMIN_ALERT_EMAIL=ops@spendigo.ca
