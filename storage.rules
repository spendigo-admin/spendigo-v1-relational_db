rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Merchant store assets — only the owning merchant can write; any auth'd user can read
    match /merchant-assets/{storeId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.storeId == storeId
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'merchant';
    }

    // User avatars — only the owner can read/write their own avatar
    match /user-avatars/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Admin-only assets (platform images, admin uploads)
    match /admin-assets/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Public product images (cached from external sources)
    match /products/{allPaths=**} {
      allow read: if true; // Publicly accessible to unauthenticated users viewing the catalog
    }

    // Publicly accessible exported JSON data
    match /public/{allPaths=**} {
      allow read: if true;
    }

    // Ads - visible to everyone, writable by admins only
    match /ads/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Merchant branding assets (logos, cover images) — flat files at root of stores/{storeId}/
    // Single-segment pattern intentionally excludes subdirectories like /documents/
    match /stores/{storeId}/{filename} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.storeId == storeId
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'merchant';
    }

    // KYB documents (business licenses, incorporation certificates)
    // Read: Spendigo admins only — merchants cannot retrieve their own submitted documents.
    // Write: store OWNER only (not MANAGER/STAFF/MARKETING).
    match /stores/{storeId}/documents/{allPaths=**} {
      allow read: if request.auth != null
                  && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow write: if request.auth != null
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.storeId == storeId
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'merchant'
                   && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.merchantRole == 'OWNER';
    }

    // Default: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
