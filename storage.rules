rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Merchant store assets — only the owning merchant can write; any auth'd user can read
    match /merchant-assets/{storeId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && get(/databases/(default)/documents/users/$(request.auth.uid)).data.storeId == storeId
                   && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'merchant';
    }

    // User avatars — only the owner can read/write their own avatar
    match /user-avatars/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Admin-only assets (platform images, admin uploads)
    match /admin-assets/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Default: deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
