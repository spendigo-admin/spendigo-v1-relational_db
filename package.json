{
  "name": "spendigo-smartcart",
  "version": "0.0.1",
  "private": true,
  "description": "Spendigo SmartCart — Canadian Marketplace Facilitator Platform",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "vitest",
    "build": "turbo run build",
    "dev": "turbo run dev --filter=!//",
    "benchmark:smartcart": "npm --prefix services/api run build && node --expose-gc scripts/benchmark-smartcart.mjs",
    "stripe:listen": "stripe listen --forward-to localhost:5001/spendigo-8540c/us-central1/stripeWebhook",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "turbo": "^1.10.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "dotenv": "^17.2.3"
  }
}
