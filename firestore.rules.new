rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Fetch User Profile Data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if user has 'admin' role
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // Check if user is a merchant
    function isMerchant() {
       return isAuthenticated() && getUserData().role == 'merchant';
    }

    // Get the storeId associated with the current merchant user
    function getMerchantStoreId() {
      return getUserData().storeId;
    }

    // --- SPENDIGO MASTER CATALOG ---

    // 1. MASTER PRODUCTS (Spendigo-Owned, Immutable by Merchants)
    match /master_products/{masterProductId} {
      allow read: if true;
      allow write: if isAdmin(); // Only Spendigo Admins (or AI) can create/update master products
    }

    // 2. MERCHANT PRODUCTS (Merchant-Owned, Inventory & Pricing)
    match /merchant_products/{merchantProductId} {
      // Public read (for customers)
      allow read: if true;

      // Merchant Write Rules
      allow create: if isMerchant() 
        && request.resource.data.merchant_id == getMerchantStoreId()
        // CRITICAL: Master product MUST exist
        && exists(/databases/$(database)/documents/master_products/$(request.resource.data.master_product_id));

      allow update: if isMerchant() 
        && resource.data.merchant_id == getMerchantStoreId();
        
      allow delete: if isMerchant() 
        && resource.data.merchant_id == getMerchantStoreId();
    }

    // 3. PRODUCT CREATION REQUESTS (Controlled Growth)
    match /product_creation_requests/{requestId} {
      allow read: if isAdmin() || (isMerchant() && resource.data.submitted_by_merchant_id == getMerchantStoreId());
      allow create: if isMerchant() && request.resource.data.submitted_by_merchant_id == getMerchantStoreId();
      allow update: if isAdmin(); // Admin updates status (pending -> approved/rejected)
    }

    // 4. CATEGORIES (Central Control)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. SUBSTITUTION GROUPS (SmartCart Core)
    match /substitution_groups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- LEGACY / EXISTING COLLECTIONS ---

    // USERS
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list: if isAdmin() || (isMerchant() && resource.data.storeId == getMerchantStoreId());
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin(); 
      allow delete: if isAdmin();
    }

    // STAFF
    match /staff/{email} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.email.lower() == email.lower());
      allow write: if isAdmin();
    }

    // STORES
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isAdmin() || (isMerchant() && request.resource.data.ownerId == request.auth.uid);
      allow update: if isAdmin() || (isMerchant() && getMerchantStoreId() == storeId);
      allow delete: if isAdmin();

      match /flyers/{flyerId} {
        allow read: if true;
        allow write: if isAdmin() || (isMerchant() && getMerchantStoreId() == storeId);
      }
      match /deals/{dealId} {
        allow read: if true;
        allow write: if isAdmin() || (isMerchant() && getMerchantStoreId() == storeId);
      }
    }

    // ORDERS
    match /orders/{orderId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || 
        (isMerchant() && resource.data.storeId == getMerchantStoreId()) ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        (isMerchant() && resource.data.storeId == getMerchantStoreId()) ||
        isAdmin()
      );
    }

    // NOTIFICATIONS
    match /notifications/{userId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated();
      allow update, delete: if isOwner(userId);
    }

    // REVIEWS
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }
    
    // CARTS & WISHLISTS
    match /carts/{cartId} {
      allow read, write: if isOwner(cartId);
    }
    match /wishlists/{wishlistId} {
      allow read, write: if isOwner(wishlistId);
    }

    // AUDIT LOGS
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
    
    // MAIL
    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // ADS
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SURVEYS & POLLS
    match /surveys/{surveyId} {
      allow read: if true;
      allow write: if isAdmin();
      match /responses/{userId} {
        allow read: if userId == request.auth.uid || isAdmin();
        allow write: if userId == request.auth.uid;
      }
    }

    // STATS
    match /stats/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}
