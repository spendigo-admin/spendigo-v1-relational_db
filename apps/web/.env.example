# Firebase project config — Firebase Console → Project Settings → Your Apps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Algolia search — Algolia Dashboard → Search API Keys (use Search-Only key, not Admin)
VITE_ALGOLIA_APP_ID=
VITE_ALGOLIA_SEARCH_KEY=
VITE_ALGOLIA_INDEX_NAME=master_products

# Firebase Cloud Messaging — Firebase Console → Project Settings → Cloud Messaging → Web Push Certificates
VITE_FIREBASE_VAPID_KEY=

# Firebase App Check — Google Cloud Console → reCAPTCHA Enterprise → Site Keys (production web only)
VITE_FIREBASE_APP_CHECK_KEY=

# Stripe — Stripe Dashboard → Developers → API Keys (publishable key only)
VITE_STRIPE_PUBLISHABLE_KEY=

# Google Gemini — Google AI Studio or Google Cloud Console → API Keys
VITE_GEMINI_API_KEY=

# Sentry — Sentry Dashboard → Project Settings → Client Keys (DSN)
VITE_SENTRY_DSN=
