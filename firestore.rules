rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the owner of the document (assuming doc has userId or is keyed by uid)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is verifying their own email in staff collection
    function isEmailOwner(email) {
      return isAuthenticated() && request.auth.token.email.lower() == email.lower();
    }

    // Fetch User Profile Data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if user has 'admin' role in their user profile
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // Check if user is a merchant
    function isMerchant() {
       return isAuthenticated() && getUserData().role == 'merchant';
    }

    // Get the storeId associated with the current merchant user
    function getMerchantStoreId() {
      return getUserData().storeId;
    }

    // --- COLLECTION RULES ---

    // 1. USERS COLLECTION
    // - Users can read and write their own profile.
    // - Admins can read all profiles and write (ban/promote) any profile.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin(); 
      allow delete: if isAdmin();
    }

    // 2. STAFF COLLECTION (Isolated Admin List)
    match /staff/{email} {
      allow read: if isAdmin() || isEmailOwner(email);
      allow write: if isAdmin();
    }

    // 3. STORES COLLECTION
    // - Public Read.
    // - Update restricted to Admins or the Store Owner.
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isAdmin() || (isMerchant() && request.resource.data.ownerId == request.auth.uid);
      
      // Update: Admin OR (Merchant who "owns" this store)
      allow update: if isAdmin() || (isMerchant() && getMerchantStoreId() == storeId);
      
      allow delete: if isAdmin();
    }

    // 4. MASTER CATALOG (New)
    // - Public Read. Writes Admin Only.
    match /catalog/{itemId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. PRODUCTS & DEALS & FLYERS (Store-Specific Resources)
    // - Public Read.
    // - Write restricted to Merchants (for their own store) or Admins.
    match /products/{productId} {
      allow read: if true;
      allow create: if isAdmin() || (isMerchant() && request.resource.data.storeId == getMerchantStoreId());
      allow update, delete: if isAdmin() || (isMerchant() && resource.data.storeId == getMerchantStoreId());
    }
    
    match /deals/{dealId} {
      allow read: if true;
      allow create: if isAdmin() || (isMerchant() && request.resource.data.storeId == getMerchantStoreId());
      allow update, delete: if isAdmin() || (isMerchant() && resource.data.storeId == getMerchantStoreId());
    }
    
    match /flyers/{flyerId} {
      allow read: if true;
      allow create: if isAdmin() || (isMerchant() && request.resource.data.storeId == getMerchantStoreId());
      allow update, delete: if isAdmin() || (isMerchant() && resource.data.storeId == getMerchantStoreId());
    }

    // 6. ORDERS
    // - Create: Any authenticated user.
    // - Read/Update: Customer OR Merchant (of that store) OR Admin.
    match /orders/{orderId} {
      allow create: if isAuthenticated();
      
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || 
        (isMerchant() && resource.data.storeId == getMerchantStoreId()) ||
        isAdmin()
      );
      
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        (isMerchant() && resource.data.storeId == getMerchantStoreId()) ||
        isAdmin()
      );
    }

    // 7. NOTIFICATIONS
    match /notifications/{userId} {
      allow read: if isOwner(userId);
      allow create: if isAuthenticated(); // Allow sending notifications
      allow update, delete: if isOwner(userId); // User can mark read or dismiss
    }

    // 8. SETTINGS
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // 9. REVIEWS
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }
    
    // 10. CARTS & WISHLISTS (Private User Data)
    match /carts/{cartId} {
      allow read, write: if isOwner(cartId);
    }
    match /wishlists/{wishlistId} {
      allow read, write: if isOwner(wishlistId);
    }

    // 11. AUDIT LOGS
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Users create logs for their actions
      allow update, delete: if false; // Immutable
    }
    
    // 12. MAIL (For Trigger Email Extension)
    match /mail/{mailId} {
      allow create: if isAuthenticated(); // Allow apps to queue emails
      allow read, update, delete: if isAdmin(); // Only admins/system should see/manage email queue
    }
  }
}
