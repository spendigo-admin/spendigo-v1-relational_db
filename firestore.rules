rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the owner of the document (assuming doc has userId or is keyed by uid)
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Check if user is verifying their own email in staff collection
    function isEmailOwner(email) {
      return isAuthenticated() && request.auth.token.email.lower() == email.lower();
    }

    // Check if user has 'admin' role in their user profile
    // Note: This requires getting the user document. 
    // Optimization: In a real app, rely on Custom Claims (request.auth.token.admin == true).
    // For this prototype, we will fetch the doc.
    function isAdmin() {
      return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Check if user is a merchant
    function isMerchant() {
       return isAuthenticated() && 
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'merchant';
    }

    // --- COLLECTION RULES ---

    // 1. USERS COLLECTION
    // - Users can read and write their own profile.
    // - Admins can read all profiles and write (ban/promote) any profile.
    // - Merchants/Public might need basic read access to names/avatars if we had a social feed, 
    //   but for now strict privacy is better.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isOwner(userId) || isAdmin(); // Owner updates profile, Admin updates status/roles
      allow delete: if isAdmin();
    }

    // 2. STAFF COLLECTION (Isolated Admin List)
    // - Super Admins (Admin role) can read/write everything.
    // - A user can read their own entry to verify if they are staff (needed for AuthContext).
    match /staff/{email} {
      allow read: if isAdmin() || isEmailOwner(email);
      allow write: if isAdmin();
    }

    // 3. STORES COLLECTION
    // - Public Read (Catalogue).
    // - Write restricted to Admins or the Store Owner (StoreId checking required).
    // - For prototype simplicity: Merchants can create, Owners can update their own.
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isMerchant() || isAdmin();
      allow update: if isAdmin() || (isMerchant() && resource.data.ownerId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // 4. PRODUCTS & DEALS & FLYERS
    // - Public Read.
    // - Write restricted to Merchants (Owners) or Admins.
    match /products/{productId} {
      allow read: if true;
      allow write: if isMerchant() || isAdmin(); 
      // ideally check if product.storeId belongs to merchant
    }
    match /deals/{dealId} {
      allow read: if true;
      allow write: if isMerchant() || isAdmin();
    }
    match /flyers/{flyerId} {
      allow read: if true;
      allow write: if isMerchant() || isAdmin();
    }

    // 5. ORDERS
    // - Create: Any authenticated user.
    // - Read: The Customer OR The Merchant (by storeId) OR Admin.
    // - Update: Customer (cancel), Merchant (status), Admin.
    match /orders/{orderId} {
      allow create: if isAuthenticated();
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid || 
        resource.data.storeId == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeId ||
        isAdmin()
      );
      allow update: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        // Check if user is the merchant owner of this order's store
        // (Simplified check: User has storeId matching order's storeId)
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.storeId == resource.data.storeId ||
        isAdmin()
      );
    }

    // 6. NOTIFICATIONS
    // - Read: Only the recipient (docId == userId).
    // - Write: Any authenticated user (needed for client-side OrderContext logic).
    match /notifications/{userId} {
      allow read: if isOwner(userId);
      allow write: if isAuthenticated(); // Needed for peer-to-peer notification sending
    }

    // 7. SETTINGS (Platform Config)
    // - Read: Public (maintenance mode check).
    // - Write: Admin only.
    match /settings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // 8. REVIEWS
    // - Read: Public.
    // - Create: Authenticated users.
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      // Only author or admin can delete/edit (if we allowed editing)
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }
    
    // 9. LOGS (Audit)
    // - Read: Admin only.
    // - Write: Authenticated users (AuditContext).
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }
  }
}
