rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Check if user is the owner of the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Fetch User Profile Data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Check if user has 'admin' role
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // Check if user is a merchant
    function isMerchant() {
       return isAuthenticated() && getUserData().role == 'merchant';
    }

    // Get the storeId associated with the current merchant user
    function getMerchantStoreId() {
      return getUserData().storeId;
    }

    // Get the merchant sub-role (OWNER | MANAGER | STAFF | MARKETING)
    function getMerchantRole() {
      return getUserData().merchantRole;
    }

    // Check if a store is in the pending_deletion grace period
    function isStorePendingDeletion(storeId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data.status == 'pending_deletion';
    }

    // --- SPENDIGO MASTER CATALOG ---

    // 1. MASTER PRODUCTS (Spendigo-Owned, Shared Growth)
    match /master_products/{masterProductId} {
      allow read: if true;
      allow create: if isAdmin() || isMerchant(); // Allow merchants to contribute new IDs
      allow update, delete: if isAdmin(); // Only Admins can modify or remove established identity
    }

    // 1B. PENDING MASTER PRODUCTS (Auto-discovered by merchants, awaiting admin approval)
    match /pending_master_products/{pendingProductId} {
      allow read: if true; // Shoppers need to see pending products if they are sold by a merchant
      allow create: if isMerchant(); // Merchants can create pending products via auto-discovery
      allow update, delete: if isAdmin(); // Only admins can commit or reject
    }

    // 2. MERCHANT PRODUCTS (Merchant-Owned, Inventory & Pricing)
    match /merchant_products/{merchantProductId} {
      // Public read (for customers)
      allow read: if true;

      // Merchant Write Rules
      allow create: if isAdmin() || (isMerchant()
        && request.resource.data.merchant_id == getMerchantStoreId()
        // CRITICAL: Product must exist in master OR pending
        && (exists(/databases/$(database)/documents/master_products/$(request.resource.data.master_product_id))
           || exists(/databases/$(database)/documents/pending_master_products/$(request.resource.data.master_product_id)))
        && !isStorePendingDeletion(request.resource.data.merchant_id));

      allow update: if isAdmin() || (isMerchant()
        // 1. Must own the existing doc
        && resource.data.merchant_id == getMerchantStoreId()
        // 2. Cannot change ownership (merchant_id)
        && request.resource.data.merchant_id == resource.data.merchant_id
        // 3. Cannot change the master product link (prevents broken links)
        // EXCEPTION: Admins can change master_product_id during commit workflow
        && (isAdmin() || request.resource.data.master_product_id == resource.data.master_product_id)
        && !isStorePendingDeletion(resource.data.merchant_id));

      allow delete: if isAdmin() || (isMerchant()
        && resource.data.merchant_id == getMerchantStoreId()
        && !isStorePendingDeletion(resource.data.merchant_id));
    }

    // 3. PRODUCT CREATION REQUESTS (Controlled Growth)
    match /product_creation_requests/{requestId} {
      allow read: if isAdmin() || (isMerchant() && resource.data.submitted_by_merchant_id == getMerchantStoreId());
      
      allow create: if isMerchant() 
        && request.resource.data.submitted_by_merchant_id == getMerchantStoreId()
        // Enforce initial status
        && request.resource.data.status == 'pending';
        
      allow update: if isAdmin(); // Admin updates status (pending -> approved/rejected)
    }

    // 4. CATEGORIES (Central Control)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. SUBSTITUTION GROUPS (SmartCart Core)
    match /substitution_groups/{groupId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- LEGACY / EXISTING COLLECTIONS ---

    // USERS
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow list: if isAdmin() || (isMerchant() && resource.data.storeId == getMerchantStoreId());
      // New accounts may only register as consumer or merchant — admin/staff roles
      // are assigned server-side only. storeId and status are also admin-only on create.
      // Consent is enforced at the application layer (ReConsentModal blocks the UI) — not
      // required on create because SSO flows (Google) create the user doc before the consent
      // modal fires, then record consent via updateDoc.
      allow create: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.role in ['consumer', 'merchant']
        && !request.resource.data.keys().hasAny(['adminRole', 'status', 'storeId']);
      // role, adminRole, merchantRole, and storeId are admin-only fields.
      // Users can only update their status from 'pending_invite' to 'active'.
      allow update: if isAdmin()
        || (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'adminRole', 'merchantRole'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['storeId']) || request.resource.data.storeId == 'store-' + userId)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
              || (resource.data.status == 'pending_invite' && request.resource.data.status == 'active'))
           )
        || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount']));
      allow delete: if isAdmin();
    }

    // CONSENT LOGS — append-only immutable records of user consent acceptance
    match /consent_logs/{logId} {
      allow create: if isAuthenticated();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // STAFF
    match /staff/{email} {
      allow read: if isAdmin() || (isAuthenticated() && request.auth.token.email.lower() == email.lower());
      allow write: if isAdmin();
    }

    // STORES
    match /stores/{storeId} {
      allow read: if true;
      allow create: if isAdmin() || (isMerchant() && request.resource.data.ownerId == request.auth.uid);
      // Merchants may update their store's operational fields.
      // Privileged fields (subscriptionTier, status, Stripe config, ownerId) are admin-only
      // to prevent self-upgrading subscriptions or re-activating suspended stores.
      allow update: if isAdmin()
        || (isMerchant() && getMerchantStoreId() == storeId
            && (
              // 1. General Profile Updates (Privileged fields like status and subscription are blocked)
              (!request.resource.data.diff(resource.data).affectedKeys()
                  .hasAny(['subscriptionTier', 'status', 'stripeAccountId',
                           'stripeOnboardingStatus', 'ownerId']))
              ||
              // 2. Deletion Requests (Merchants ARE allowed to move status to 'pending_deletion')
              (request.resource.data.status == 'pending_deletion'
               && !request.resource.data.diff(resource.data).affectedKeys()
                   .hasAny(['subscriptionTier', 'stripeAccountId', 'stripeOnboardingStatus', 'ownerId']))
              ||
              // 3. KYB Document Submission (store OWNER only — not MANAGER/STAFF/MARKETING)
              (request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['kybDocuments', 'kybStatus'])
               && request.resource.data.kybStatus in ['not_submitted', 'pending_review']
               && getMerchantRole() == 'OWNER')
            )
           )
        || (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating', 'reviewCount']));
      allow delete: if isAdmin();

      match /flyers/{flyerId} {
        allow read: if true;
        allow write: if isAdmin() || (isMerchant() && getMerchantStoreId() == storeId
            && !isStorePendingDeletion(storeId));
      }
      match /deals/{dealId} {
        allow read: if true;
        allow write: if isAdmin() || (isMerchant() && getMerchantStoreId() == storeId
            && !isStorePendingDeletion(storeId));
      }
      match /analytics/{dateId} {
        allow read: if isAdmin() || (isMerchant() && getMerchantStoreId() == storeId);
        // Anyone (including unauthenticated visitors) may increment the view counter.
        // Write is restricted to only the `views` and `date` fields to prevent abuse.
        allow create, update: if request.resource.data.keys().hasOnly(['views', 'date']);
      }
    }

    // SCHEDULED INGESTION JOBS — admin-only read/write
    match /scheduled_ingestion/{jobId} {
      allow read, write: if isAdmin();
    }

    // PUBLIC FLYERS (Ingested Grocery Deals)
    match /public_flyers/{flyerId} {
      allow read: if true;
      allow write: if isAdmin();

      match /deals/{dealId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // FLYER DEAL INDEX (Flat time-series index for predictive analytics — written by Cloud Functions)
    match /flyer_deal_index/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // FLYER ANALYTICS (Pre-computed deal quality stats — written by Cloud Functions)
    match /flyer_analytics/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // ORDERS
    match /orders/{orderId} {
      // Orders are created server-side only (via placeOrder Cloud Function using Admin SDK)
      allow create: if false;
      allow read: if isAuthenticated() && (
        resource.data.customerId == request.auth.uid ||
        (isMerchant() && resource.data.storeId == getMerchantStoreId()) ||
        isAdmin()
      );
      // Customers may only cancel their own orders (no other field changes).
      // Merchants may update operational fields only (status, payment confirmation, timing).
      // Admins have full update access.
      allow update: if isAuthenticated() && (
        isAdmin()
        || (isMerchant() && resource.data.storeId == getMerchantStoreId()
            // Merchants may only touch operational fields — never totals, items, or customer data
            && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['status', 'rejectionReason', 'estimatedTime',
                          'paymentStatus', 'paymentCollectedBy', 'emailQueued',
                          'emailQueuedAt', 'cancelledAt']))
        || (resource.data.customerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status == 'cancelled')
      );
    }

    // NOTIFICATIONS (Subcollection)
    match /users/{userId}/notifications/{notificationId} {
      // User can manage their own notifications
      allow read, update, delete: if isOwner(userId);
      // Owner or admin can create; enforce minimum required fields to prevent junk writes.
      allow create: if (isOwner(userId) || isAdmin())
        && request.resource.data.keys().hasAll(['id', 'type', 'title', 'message', 'timestamp', 'read'])
        && request.resource.data.type in ['price_drop', 'order', 'promo', 'system', 'alert', 'review', 'approval', 'stock'];
    }

    // Deprecated
    match /notifications/{userId} {
      allow read, write: if false;
    }

    // REVIEWS
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['helpfulCount', 'voters']);
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
    }
    
    // CARTS & WISHLISTS
    match /carts/{cartId} {
      allow read, write: if isOwner(cartId);
    }
    match /wishlists/{wishlistId} {
      allow read, write: if isOwner(wishlistId);
    }
    match /comparison_wishlists/{wishlistId} {
      allow read, write: if isOwner(wishlistId);
    }

    // AUDIT LOGS — append-only via Cloud Functions (Admin SDK) only.
    // Direct client writes are blocked; the recordAuditEvent callable uses Admin SDK
    // which bypasses client rules entirely.
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if false;
    }

    // AUDIT LOG META — singleton doc that serializes concurrent chain writes.
    match /audit_logs_meta/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // SYSTEM BACKUPS — written exclusively by Cloud Functions (Admin SDK).
    // Admin-only read to surface backup status in the health dashboard.
    match /system_backups/{docId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // CAMPAIGN LOGS — written by sendCampaign Cloud Function (Admin SDK).
    // Merchants can read their own store's campaign history; nobody can write directly.
    match /campaign_logs/{logId} {
      allow read: if isAdmin() || (isMerchant() && resource.data.storeId == getMerchantStoreId());
      allow write: if false;
    }

    // PAYMENTS — webhook mirror written by Stripe webhook Cloud Function (Admin SDK).
    // Merchants can read their own store's payment records for reconciliation.
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isMerchant() && resource.data.storeId == getMerchantStoreId());
      allow write: if false;
    }
    
    // MAIL
    match /mail/{mailId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // ADS
    match /ads/{adId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views', 'clicks'])
      );
    }

    // CAREERS
    match /careers/{jobId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // JOB APPLICATIONS
    match /job_applications/{applicationId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // SURVEYS & POLLS
    match /surveys/{surveyId} {
      allow read: if true;
      allow write: if isAdmin();
      match /responses/{userId} {
        allow read: if userId == request.auth.uid || isAdmin();
        allow write: if userId == request.auth.uid;
      }
    }

    // SETTINGS (Platform Config)
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // STATS
    // Clients may only update the traffic doc (used by traffic.ts for visitor counting).
    // Full writes (create, delete) are admin-only to prevent manipulation.
    match /stats/{docId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAuthenticated() && docId == 'traffic';
    }
  }
}
